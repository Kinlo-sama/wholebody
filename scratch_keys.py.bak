import torch
import sys
import re

sys.path.insert(0, '.')
from wholebody.models.base import TopDownPoseEstimator

config = {
    'pretrained': None,
    'test_cfg': {'flip_test': True, 'shift_heatmap': False},
    'backbone': {
        'type': 'CSPNeXt',
        'arch': 'P5',
        'expand_ratio': 0.5,
        'deepen_factor': 1.0,
        'widen_factor': 1.0,
        'channel_attention': True,
        'out_indices': [2, 3, 4]
    },
    'neck': {
        'type': 'CSPNeXtPAFPN',
        'in_channels': [256, 512, 1024],
        'out_channels': None,
        'out_indices': [1, 2],
        'num_csp_blocks': 2,
        'expand_ratio': 0.5
    },
    'head': {
        'type': 'RTMWHead',
        'in_channels': 1024,
        'out_channels': 133,
        'input_size': [384, 288],
        'in_featuremap_size': [12, 9],
        'simcc_split_ratio': 2.0,
        'final_layer_kernel_size': 7,
        'gau_cfg': {
            'hidden_dims': 256,
            's': 128,
            'expansion_factor': 2,
            'dropout_rate': 0.0,
            'drop_path': 0.0,
            'act_fn': 'SiLU',
            'use_rel_bias': False,
            'pos_enc': False
        },
        'codec': {
            'type': 'SimCCLabel',
            'input_size': [384, 288],
            'sigma': 6.0,
            'simcc_split_ratio': 2.0,
            'normalize': False
        }
    }
}

model = TopDownPoseEstimator(config)
model_keys = set(model.state_dict().keys())

checkpoint = torch.load('weights/rtmw-l_384x288_ported.pth', map_location='cpu')
ckpt_state = checkpoint['state_dict'] if 'state_dict' in checkpoint else checkpoint
ckpt_keys = set(ckpt_state.keys())

# Let's map ckpt keys to model keys if possible!
new_state = {}
for k, v in ckpt_state.items():
    new_k = k
    if 'depthwise_conv' in new_k:
        new_k = new_k.replace('depthwise_conv', 'depthwise')
    if 'pointwise_conv' in new_k:
        new_k = new_k.replace('pointwise_conv', 'pointwise')
    new_state[new_k] = v

missing = model_keys - set(new_state.keys())
extra = set(new_state.keys()) - model_keys

print(f"Missing keys after remapping: {len(missing)}")
for k in sorted(list(missing))[:10]:
    print("  ", k)
print(f"Extra keys after remapping: {len(extra)}")
for k in sorted(list(extra))[:10]:
    print("  ", k)

